# ============================================================================
# Ship-list mode: this file lists what IS published, not what is ignored.
#
# Everything is ignored by default (the "/*" below) and the shipped paths are
# re-included with "!". The private working docs, local notes and design assets
# are therefore never named here — the file only reveals what the repository
# publishes.
#
# Consequence: a NEW top-level file or directory is ignored until it is added to
# the allow-list below. If something you just created does not show up in
# "git status", that is why.
# ============================================================================

# Ignore everything at the top level, unless re-included below.
/*

# --- Shipped: top level -----------------------------------------------------
!/.dockerignore
!/.gitattributes
!/.github/
!/.gitignore
!/.gitmodules
!/Directory.Build.props
!/Dockerfile
!/LICENSE
!/LazerRender.sln
!/README.md
!/docker-compose.yml
!/LazerRender.Game/
!/LazerRender.Service/

# --- NOT shipped ------------------------------------------------------------
# Listed after the negations above, so these win inside the shipped trees too.

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
*.log
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
.vs/
.idea/
.zed/
*.swp

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# OS
.DS_Store
Thumbs.db

# Test / coverage
[Tt]est[Rr]esult*/
[Cc]overage/
*.coverage
*.coveragexml

# Tool output
videos/
captures/
*.mp4
*.mkv
*.webm

# Local secrets / machine paths
*.local.json
.env

# Runtime data and generated trees (SQLite DB, uploads/jobs/results, the Data
# Protection key ring, lazer's Realm storage, publishes). Never committed.
data/
keys/
uploads/
jobs/
results/
publish/
storage/

# Private replay fixtures used for local testing.
LazerRender.Game/tests/
*.osr

# Scratch output directories from local render tests.
out*/
frames/
test_output/

# Private working notes and design assets. Root-anchored so a shipped "assets"
# directory elsewhere (the SPA's wwwroot/assets) is unaffected.
/dev/
/assets/

# Documentation: only the two published files. Everything else — the private
# planning/maintenance docs and any future working notes — is covered here
# without ever being named.
*.md
!README.md
!LazerRender.Game/WEB_GUI_GUIDE.md
