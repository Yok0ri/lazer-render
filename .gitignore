# LazerRender runtime data (web service storage + engine realm/ini/db)
# Never commit these: they hold the SQLite DB, the Data Protection key ring,
# lazer's Realm database and its config (which can transiently hold the
# injected osu! token).
data/
keys/
uploads/
jobs/
results/
publish/
storage/

# Private replay fixtures used for local testing — never shipped.
LazerRender.Game/tests/
*.osr

# Scratch output directories from local render tests.
out*/
frames/
test_output/
