<Project>

  <!--
    Central package management for the service half only.

    This file lives under LazerRender.Service/ deliberately: MSBuild resolves Directory.Packages.props
    by walking up from each project and stopping at the first one found, so the engine
    (LazerRender.Game/, which has no PackageReferences of its own) and the pinned extern/osu submodule
    are unaffected. Enabling it at the repository root would apply to the submodule's projects and
    break their own pinned versions.

    A lock file is generated per project so transitive versions cannot drift silently within the ranges
    the top-level packages allow. Restore still updates the lock files when a package changes, so this
    records the inventory without blocking development.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- Only referenced by Debug builds; see LazerRender.Api.csproj. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.6.6" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

</Project>
