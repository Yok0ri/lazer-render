[Unit]
Description=LazerRender web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lazerrender
Group=lazerrender
WorkingDirectory=/opt/lazerrender
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_CONTENTROOT=/opt/lazerrender
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
EnvironmentFile=/opt/lazerrender/lazerrender.env
ExecStart=/opt/lazerrender/LazerRender.Api
Restart=on-failure
RestartSec=5

# Hardening: the self-contained app only needs to write its runtime data and DPAPI keys.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lazerrender/data /opt/lazerrender/keys
LimitNOFILE=65536

# The key ring decrypts every stored osu! token. The app enforces 0700 itself at startup; this is
# belt-and-braces for hosts whose keys/ was created by an earlier version with a laxer umask.
ExecStartPre=/bin/sh -c 'chmod 700 /opt/lazerrender/keys; chmod 600 /opt/lazerrender/keys/*.xml 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
